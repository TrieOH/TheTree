#!/bin/sh
# pre-commit — per-commit quality layer (plan §3 layering + §3.7).
#
#   0. gitleaks over the staged diff — secret-only, fast by construction.
#      (Full vuln+misconfig scanning is the deploy lane's job; hotfix lane
#      runs none, so this per-commit scan is what guards between deploys.)
#   1. checks for exactly what changed, via the diff∩scope engine — the
#      declared commit scope is never trusted, only the raw diff matters:
#        go:<dir>  → golangci-lint + gotestsum -- -short
#                    (testcontainers skip under -short; integration tests
#                     are the deploy lane's R6 job — Docker NOT required)
#        ts:<dir>  → package.json scripts run if present:
#                    check → tsc / typecheck → test
#                    front/univents-solid is a nested independent workspace;
#                    `pnpm -C <dir>` works for it identically.
#
# Workspace-level files fan out by what they can actually break:
#   go.work / go.work.sum / .golangci.yml → all Go members
#   pnpm-lock.yaml / pnpm-workspace.yaml / package.json / patches → all
#   root-workspace TS members (univents-solid has its own lockfile — root
#   lock files don't affect it).

set -eu

ENGINE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/thetree-precommit.XXXXXX")
trap 'rm -rf "$ENGINE_TMP"' EXIT
. "$(dirname "$0")/lib/engine.sh"

# --- 0. secret scan of staged content ---------------------------------------

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '  ✗ gitleaks not found — install it with:  just setup\n'
    exit 1
fi

printf '▶ gitleaks — staged diff secret scan\n'
if ! gitleaks protect --staged --redact --no-banner; then
    printf '\n'
    printf '  ✗ gitleaks found secrets in the staged changes.\n'
    printf '    Remove them; rotate the credential if it ever left this machine.\n'
    exit 1
fi
printf '  ✓ no secrets in staged changes\n'

# --- 1. classify staged files into check targets -----------------------------

git diff --cached --name-only --diff-filter=ACMRD >"$ENGINE_TMP/staged"

if [ ! -s "$ENGINE_TMP/staged" ]; then
    printf '✓ nothing staged\n'
    exit 0
fi

engine_targets "$ENGINE_TMP/staged" >"$ENGINE_TMP/targets"

if [ ! -s "$ENGINE_TMP/targets" ]; then
    printf '✓ nothing to check (staged changes have no runnable checks)\n'
    exit 0
fi

pids="$ENGINE_TMP/pids"
: >"$pids"
: >"$ENGINE_TMP/go_targets"
: >"$ENGINE_TMP/ts_targets"

# --- 2. run checks per target, in parallel -----------------------------------
# golangci-lint refuses concurrent runs (lock file), so Go lints run
# sequentially inside one background chain; gotestsum runs are independent
# and go in parallel; TS targets each get their own job.

for t in $(cat "$ENGINE_TMP/targets"); do
    case "$t" in
        go:*) echo "$t" >>"$ENGINE_TMP/go_targets" ;;
        ts:*) echo "$t" >>"$ENGINE_TMP/ts_targets" ;;
    esac
done

has_script() {
    node -e "const s=require('./$1/package.json').scripts||{};process.exit(s.$2?0:1)" 2>/dev/null
}

run_lint() {
    dir=${1#go:}
    work="$ENGINE_TMP/$dir"; mkdir -p "$work"
    log="$work/lint.log"
    {
        echo "golangci-lint run ./$dir/..."
        golangci-lint run "./$dir/..."
    } >"$log" 2>&1
    echo $? >"$work/lint.status"
}

run_test() {
    dir=${1#go:}
    work="$ENGINE_TMP/$dir"; mkdir -p "$work"
    log="$work/test.log"
    {
        echo "gotestsum --format testdox -- -short ./...   (in $dir)"
        (cd "$dir" && gotestsum --format testdox --format-hide-empty-pkg -- -short ./...)
    } >"$log" 2>&1
    echo $? >"$work/test.status"
}

run_ts() {
    dir=${1#ts:}
    work="$ENGINE_TMP/$dir"; mkdir -p "$work"
    log="$work/log"
    : >"$log"
    rc=0
    for s in check tsc typecheck test; do
        if [ -f "$dir/package.json" ] && has_script "$dir" "$s"; then
            echo "pnpm -C $dir run $s" >>"$log"
            if ! pnpm -C "$dir" run "$s" >>"$log" 2>&1; then
                rc=1
                break
            fi
        fi
    done
    echo "$rc" >"$work/status"
}

desc() {
    t=$1
    dir=${t#*:}
    case "$t" in
        go:*)
            what="lint + test (-short)"
            [ -f "$ENGINE_TMP/$dir/test.log" ] || what="lint"
            echo "$dir — $what" ;;
        ts:*)
            if [ ! -f "$dir/package.json" ]; then
                echo "$dir — no package.json, skipped"
                return 0
            fi
            what=""
            for s in check tsc typecheck test; do
                if has_script "$dir" "$s"; then what="$what$s "; fi
            done
            [ -n "$what" ] && echo "$dir — $what" || echo "$dir — no runnable scripts, skipped" ;;
    esac
}

for tool in golangci-lint gotestsum pnpm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '  ✗ %s not found — install it with:  just setup\n' "$tool"
        exit 1
    fi
done

if [ -s "$ENGINE_TMP/go_targets" ]; then
    # lint chain: sequential (golangci-lint lock), as one background job
    (
        while IFS= read -r t; do
            echo "▶ ${t#go:} — lint"
            run_lint "$t"
        done <"$ENGINE_TMP/go_targets"
    ) &
    echo "$!" >>"$pids"

    while IFS= read -r t; do
        echo "▶ ${t#go:} — test (-short)"
        run_test "$t" &
        echo "$!" >>"$pids"
    done <"$ENGINE_TMP/go_targets"
fi

while IFS= read -r t; do
    echo "▶ $(desc "$t")"
    run_ts "$t" &
    echo "$!" >>"$pids"
done <"$ENGINE_TMP/ts_targets"

while IFS= read -r p; do
    wait "$p" || true
done <"$pids"

# --- 3. report + derive exit code --------------------------------------------

fail=0
total=0
while IFS= read -r t; do
    total=$((total + 1))
    dir=${t#*:}
    work="$ENGINE_TMP/$dir"
    logs="$work/log"
    case "$t" in
        go:*)
            rc=0
            [ "$(cat "$work/lint.status" 2>/dev/null || echo 1)" -eq 0 ] || rc=1
            [ "$(cat "$work/test.status" 2>/dev/null || echo 1)" -eq 0 ] || rc=1
            logs="$work/lint.log $work/test.log"
            ;;
        ts:*)
            rc=$(cat "$work/status" 2>/dev/null || echo 1)
            ;;
    esac
    if [ "$rc" -eq 0 ]; then
        printf '✓ %s\n' "$(desc "$t")"
    else
        fail=1
        printf '✗ %s\n' "$(desc "$t")"
        for l in $logs; do
            [ -f "$l" ] && cat "$l"
        done
        printf '\n'
    fi
done <"$ENGINE_TMP/targets"

if [ "$fail" -eq 0 ]; then
    printf '✓ all %s checks passed\n' "$total"
else
    printf '✗ some checks failed\n'
fi
exit "$fail"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  // Issues, PRs, deploys and metric rollups land here from webhooks and
  // crons; pages only ever read this, never the APIs or Postgres.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal",
      "database_id": "7663a817-9d3e-412f-bcc0-c95146edfca4",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* and /webhooks/* reach the Worker even when a file would match.
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  // Hourly catch-up from Linear (the first run is the backfill). Only reads
  // Linear and writes D1.
  // Hourly at :07, Linear's catch-up (the first run is the backfill); every
  // 30 minutes, Cloudflare analytics, Neon and Grafana Cloud. Only reads those APIs and the
  // container budget's KV, and writes D1.
  "triggers": {
    "crons": ["7 * * * *", "*/30 * * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "fdc6590fe9b028c608005c515140ff74",
    // Grafana Cloud's Prometheus query API (latency, endpoints, error types).
    "GRAFANA_PROM_URL": "https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom",
    "GRAFANA_PROM_USER": "3613302"
  },
  // The container budget the four API Workers keep (@trieoh/container-budget).
  // The portal only reads it.
  "kv_namespaces": [{ "binding": "BUDGET", "id": "bc65d11390534722b1bfca37d503e99b" }],
  // Runtime secrets (`wrangler secret put`); deploys fail while one is missing.
  "secrets": {
    "required": [
      "LINEAR_API_KEY",
      "LINEAR_WEBHOOK_SECRET",
      "GITHUB_WEBHOOK_SECRET",
      "DEPLOY_HOOK_SECRET",
      "CLOUDFLARE_ANALYTICS_TOKEN",
      "NEON_API_KEY",
      // Grafana Cloud access policy token: metrics, logs and traces read only.
      "GRAFANA_READ_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    // exported to Grafana Cloud only (persist: false); destinations are account-level (Workers Observability)
    "traces": { "enabled": true, "destinations": ["grafana-traces"], "persist": false },
    "logs": { "enabled": true, "destinations": ["grafana-logs"], "persist": false }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "informd",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
    // exported to Grafana Cloud; destinations are account-level (Workers Observability)
    "traces": { "enabled": true, "destinations": ["grafana-traces"] },
    "logs": { "enabled": true, "destinations": ["grafana-logs"] }
  },
  // Runtime secrets (`wrangler secret put`). Declared so `wrangler types` is
  // built from config, not a local .env, and deploys fail while one is
  // missing. Local dev also only loads the .env keys declared here; build-time
  // VITE_* values are inlined by Vite, not read from the Worker env.
  "secrets": { "required": ["AUTH_SESSION_PASSWORD"] },
}
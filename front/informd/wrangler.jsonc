{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "informd",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
    // exported to Grafana Cloud only (persist: false); destinations are account-level (Workers Observability)
    "traces": { "enabled": true, "destinations": ["grafana-traces"], "persist": false },
    "logs": { "enabled": true, "destinations": ["grafana-logs"], "persist": false }
  },
  // Runtime secrets (`wrangler secret put`). Declared so `wrangler types` is
  // built from config, not a local .env, and deploys fail while one is
  // missing. Local dev also only loads the .env keys declared here; build-time
  // VITE_* values are inlined by Vite, not read from the Worker env.
  "secrets": { "required": ["AUTH_SESSION_PASSWORD"] },
  // Production config, reviewed with the code. `vite build` inlines the VITE_*
  // ones into the bundle (@trieoh/front-core/vite/wrangler-vars); dev reads .env.
  "vars": {
    "VITE_APP_TITLE": "Informd",
    "VITE_API_URL": "https://api.informd.trieoh.com",
    "VITE_AUTH_API_URL": "https://api.identityx.trieoh.com",
    "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
    "VITE_POSTHOG_KEY": "phc_",
    "VITE_TRIEOH_AUTH_PROJECT_ID": "01a01f27-2a79-7136-a7e8-22c8099baf71" // public: inlined into the browser bundle. gitleaks:allow
  },
}
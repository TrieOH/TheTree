/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "payssage",
    "compatibility_date": "2025-09-02",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "@tanstack/react-start/server-entry",
    "observability": {
        "enabled": true,
        // exported to Grafana Cloud only (persist: false); destinations are account-level (Workers Observability)
        "traces": { "enabled": true, "destinations": ["grafana-traces"], "persist": false },
        "logs": { "enabled": true, "destinations": ["grafana-logs"], "persist": false }
    },
    // Runtime secrets (`wrangler secret put`). Declared so `wrangler types` is
    // built from config, not a local .env, and deploys fail while one is
    // missing. Local dev also only loads the .env keys declared here; build-time
    // VITE_* values are inlined by Vite, not read from the Worker env.
    "secrets": { "required": ["AUTH_SESSION_PASSWORD", "IDENTITYX_ACCESS_API_KEY"] },
    // Production config, reviewed with the code. `vite build` inlines the VITE_*
    // ones into the bundle (@trieoh/front-core/vite/wrangler-vars); dev reads .env.
    "vars": {
        "VITE_APP_TITLE": "Payssage",
        "VITE_API_URL": "https://api.payssage.trieoh.com",
        "VITE_AUTH_API_URL": "https://api.identityx.trieoh.com",
        "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
        "VITE_POSTHOG_KEY": "phc_",
        "VITE_TRIEOH_AUTH_PROJECT_ID": "01a0026c-f093-7f7d-b751-a54a7d9b42d0", // public: inlined into the browser bundle. gitleaks:allow
        "VITE_SUPPORTED_PROVIDERS": "mercadopago",
        "VITE_INTENT_TEST_MODE": "true"
    }
    /**
    * Smart Placement
    * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
    */
    // "placement": {  "mode": "smart" }
    /**
    * Bindings
    * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
    * databases, object storage, AI inference, real-time communication and more.
    * https://developers.cloudflare.com/workers/runtime-apis/bindings/
    */
    /**
    * Environment Variables
    * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
    * Note: Use secrets to store sensitive data.
    * https://developers.cloudflare.com/workers/configuration/secrets/
    */
    // "vars": {  "MY_VARIABLE": "production_value" }
    /**
    * Static Assets
    * https://developers.cloudflare.com/workers/static-assets/binding/
    */
    // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
    /**
    * Service Bindings (communicate between multiple Workers)
    * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
    */
    // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
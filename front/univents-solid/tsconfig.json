{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true,
    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "@cloudflare/vitest-plugin"
    ]
  }
}
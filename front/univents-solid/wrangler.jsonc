{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "univents",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  // Production config, reviewed with the code. `vite build` inlines the VITE_*
  // ones into the bundle (@trieoh/front-core/vite/wrangler-vars); dev reads .env.
  "vars": {
    "TRACES_ENABLED": "true",
    "VITE_APP_TITLE": "Univents",
    "VITE_API_URL": "https://api.univents.com.br",
    "VITE_AUTH_API_URL": "https://api.identityx.trieoh.com",
    "VITE_STORAGE_URL": "https://media.univents.com.br",
    "VITE_TRACING_ENABLED": "true",
    "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
    "VITE_POSTHOG_KEY": "phc_wXcugn9T53MaiGnmE9wnUD42VJ2fgARse93wi2PCZnVH", // public: inlined into the browser bundle. gitleaks:allow
    "VITE_TRIEOH_AUTH_PROJECT_ID": "01a00284-7b25-7f91-8e29-bdf7b4708fba", // public: inlined into the browser bundle. gitleaks:allow
    // optional overrides; empty means the defaults in storage-handlers.ts
    "STORAGE_IMAGE_ALLOWED_TYPES": "",
    "STORAGE_IMAGE_MAX_SIZE_BYTES": "",
    "STORAGE_IMAGE_UPLOAD_EXPIRES_SECONDS": "",
    "STORAGE_IMAGE_MODERATION_MODEL": "",
    "STORAGE_IMAGE_MODERATION_PROMPT": ""
  },
  // Runtime secrets (`wrangler secret put`). Declared so `wrangler types` is
  // built from config, not a local .env, and deploys fail while one is
  // missing. Local dev also only loads the .env keys declared here or in vars.
  "secrets": {
    "required": [
      "AUTH_SESSION_PASSWORD",
      "IDENTITYX_ACCESS_API_KEY",
      "S3_ENDPOINT",
      "S3_BUCKET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY",
      "OTEL_EXPORTER_OTLP_ENDPOINT",
      "OTEL_EXPORTER_OTLP_HEADERS",
      "OTEL_EXPORTER_OTLP_PROTOCOL"
    ]
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true,
    // exported to Grafana Cloud only (persist: false); destinations are account-level (Workers Observability)
    "traces": { "enabled": true, "destinations": ["grafana-traces"], "persist": false },
    "logs": { "enabled": true, "destinations": ["grafana-logs"], "persist": false }
  }
}
# PostHog configuration, get your key from https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_xxx
VITE_TRACING_ENABLED=false
# Optional: PostHog API host (for self-hosted or EU cloud)
# VITE_POSTHOG_HOST=https://us.i.posthog.com

VITE_APP_TITLE=Univents
VITE_API_URL=http://localhost:8081/
VITE_AUTH_API_URL=http://localhost:8080/
VITE_TRIEOH_AUTH_PROJECT_ID=project_id

# 1. URL pública de visualização de imagens (usada no Frontend e retornada após upload):
# - MinIO local: http://localhost:9000/univents
# - Cloudflare R2: https://pub-<hash>.r2.dev (ou seu domínio customizado como https://cdn.seudominio.com)
VITE_STORAGE_URL=http://localhost:9000/univents

# 2. Operação S3 / Cloudflare R2 (API privada para upload no backend):
# - MinIO local:
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=univents
S3_ACCESS_KEY_ID=key
S3_SECRET_ACCESS_KEY=key

# - Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=univents
# S3_ACCESS_KEY_ID=key
# S3_SECRET_ACCESS_KEY=key

# Persistent background upload queue
VITE_UPLOAD_MAX_RETRIES=5
VITE_UPLOAD_RETRY_BASE_DELAY_MS=1000
VITE_UPLOAD_RETRY_MAX_DELAY_MS=30000

IDENTITYX_ACCESS_API_KEY=key
# At least 32 random characters. Configure as a Wrangler secret in production.
AUTH_SESSION_PASSWORD=replace-with-at-least-32-random-characters

TRACES_OTLP_USER=ddd
TRACES_OTLP_PASSWORD=ddd
TRACES_OTLP_URL=http://localhost:10428/insert/opentelemetry/v1/traces
TRACES_ENABLED="true" #true or false

# Image preprocessing defaults (all optional)
# Comma-separated MIME types allowed by the image flow
STORAGE_IMAGE_ALLOWED_TYPES=image/png,image/jpeg,image/webp
# Maximum upload size in bytes
STORAGE_IMAGE_MAX_SIZE_BYTES=10485760 # 10MB
# Signed URL expiration in seconds
STORAGE_IMAGE_UPLOAD_EXPIRES_SECONDS=300
# Cloudflare AI model used for moderation
STORAGE_IMAGE_MODERATION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
# Prompt sent to the moderation model
STORAGE_IMAGE_MODERATION_PROMPT=Does this image contain any explicit, violent, or inappropriate content? Reply with only 'safe' or 'unsafe'.

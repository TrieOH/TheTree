{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "univents-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "api.univents.com.br", "custom_domain": true }],

	"containers": [
		{
			"class_name": "UniventsContainer",
			"image": "../Dockerfile",
			// The Dockerfile copies the Go workspace, so it builds from the repo root.
			"image_build_context": "../../..",
			"instance_type": "basic",
			"max_instances": 3,
			// Next to Neon (São Paulo).
			"constraints": { "regions": ["SAM"] }
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "UNIVENTS", "class_name": "UniventsContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UniventsContainer"] }],

	// Background jobs: the container enqueues through the producer (delayed
	// jobs carry their delay), the consumer delivers each job back to the
	// container's /events. Retries back off per message (src/index.ts); a
	// job out of retries lands on the dead-letter queue, kept for inspection.
	"queues": {
		"producers": [{ "queue": "univents-jobs", "binding": "JOBS" }],
		"consumers": [
			{
				"queue": "univents-jobs",
				"max_batch_size": 10,
				"max_retries": 10,
				"dead_letter_queue": "univents-jobs-dlq"
			}
		]
	},

	// Every string binding, var or secret, reaches the container as an
	// environment variable (src/index.ts); the keys are those of
	// api/univents/.example.env, minus JOBS_URL. Public config lives here,
	// reviewed with the code.
	"vars": {
		"APP_NAME": "univents",
		"APP_URL": "https://dev.univents.com.br",
		"API_URL": "https://api.univents.com.br",
		"CORS_ALLOWED_ORIGINS": "https://dev.univents.com.br",
		"CORS_ALLOWED_HEADERS": "Content-Type,X-Request-ID,Authorization,X-API-KEY,Refresh-Token",
		"PROFILE_PORT": "6063",
		"REQUIRE_VERIFIED_EMAIL": "true",
		"IDENTITY_X_URL": "https://api.identityx.trieoh.com",
		"IDENTITY_X_PROJECT_ID": "01a00284-7b25-7f91-8e29-bdf7b4708fba",
		"PAYSSAGE_URL": "https://api.payssage.trieoh.com",
		"PAYSSAGE_WALLET_ID": "01a00289-1927-7daf-bba1-6e8c36602b76",
		"SMTP_HOST": "mail.trieoh.com",
		"SMTP_PORT": "587",
		"SMTP_FROM": "univents@trieoh.com",
		"SMTP_TLS": "true",
	},
	// Credentials are Worker secrets, set one at a time with
	// `wrangler secret put NAME` and kept across deploys. Listing them makes
	// `wrangler types` type them without reading a local .dev.vars/.env.
	// OBJECT_STORAGE_ENDPOINT and _USE_SSL stay secrets until the storage
	// endpoint is settled.
	"secrets": {
		"required": [
			"UNIVENTS_POSTGRES_HOST",
			"UNIVENTS_POSTGRES_PORT",
			"UNIVENTS_POSTGRES_DB",
			"UNIVENTS_POSTGRES_USER",
			"UNIVENTS_POSTGRES_PASSWORD",
			"IDENTITY_X_API_KEY",
			"HMAC_SECRET",
			"PAYSSAGE_API_KEY",
			"PAYSSAGE_WEBHOOK_SECRET",
			"OBJECT_STORAGE_ENDPOINT",
			"OBJECT_STORAGE_ACCESS_KEY",
			"OBJECT_STORAGE_SECRET_KEY",
			"OBJECT_STORAGE_USE_SSL",
			"SMTP_USERNAME",
			"SMTP_PASSWORD",
			"SIMPLE_AUTH_USER",
			"SIMPLE_AUTH_PASS",
		],
	},
}

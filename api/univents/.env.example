# ── Example environment file for Univents ─────────────────────────────────
# Copy to .env and fill in your values.
#
# Required vars are marked with [required].
# Optional vars show their default value.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080                            # [optional] default: 8080
PROFILE_PORT=6060                    # [optional] default: 6060
APP_NAME=univents                    # [required]
APP_URL=https://dev.univents.com.br  # [required]
DEBUG_MODE=false                     # [optional] default: false
HMAC_SECRET=change-me                # [required] at least 32 random chars
CORS_ALLOWED_ORIGINS=http://localhost:3002  # [required] comma-separated
CORS_ALLOWED_HEADERS=Content-Type,X-Request-ID,Authorization,refresh_token,X-API-KEY  # [required]

# ── Postgres ──────────────────────────────────────────────────────────────
UNIVENTS_POSTGRES_HOST=localhost    # [required]
UNIVENTS_POSTGRES_PORT=5432         # [optional] default: 5432
UNIVENTS_POSTGRES_DB=univents       # [required]
UNIVENTS_POSTGRES_USER=univents     # [required]
UNIVENTS_POSTGRES_PASSWORD=secure-password  # [required]
MIGRATION_PATH=./db/migrations      # [optional] default: ./db/migrations

# Root Postgres (for DB bootstrapping / migrations)
POSTGRES_USER=postgres              # [required]
POSTGRES_PASSWORD=postgres          # [required]
POSTGRES_DB=postgres                # [optional] default: postgres

# ── IdentityX ─────────────────────────────────────────────────────────────
IDENTITY_X_URL=http://identityx:8080            # [required]
IDENTITY_X_API_KEY=univents_v1_prod_xxx         # [required]
IDENTITY_X_PROJECT_ID=019f9193-a18b-789b-9067-ed42c06315f8  # [required]

# ── Object Storage (RustFS / S3-compatible) ───────────────────────────────
OBJECT_STORAGE_ENDPOINT=http://rustfs:9000      # [required]
OBJECT_STORAGE_ACCESS_KEY=minioadmin            # [required]
OBJECT_STORAGE_SECRET_KEY=minioadmin            # [required]
OBJECT_STORAGE_USE_SSL=false                    # [optional] default: true
OBJECT_STORAGE_REGION=us-east-1                 # [optional] default: us-east-1

# ── SMTP / Email ──────────────────────────────────────────────────────────
#
# ── Self-hosted with Mox ──────────────────────────────────────────────────
# Mox is our mail server. You need an account with SMTP access.
#
# 1. SSH into the mail server and create an account:
#      mox account add no-reply@yourdomain.com
#
# 2. Set the account password (this is your SMTP_PASSWORD):
#      mox setaccountpassword no-reply@yourdomain.com
#
# 3. Configure Univents:
#      SMTP_HOST=mail.yourdomain.com      ← your Mox server's hostname
#      SMTP_PORT=587                      ← STARTTLS submission
#      SMTP_USERNAME=no-reply@yourdomain.com   ← full email address
#      SMTP_PASSWORD=the-password-you-set       ← from step 2
#      SMTP_FROM=no-reply@yourdomain.com  ← must be the same account
#
# Note: Mox authenticates with the full email address as the username.
#       The password is not your login password — it's the SMTP-specific
#       password you set with `mox setaccountpassword`.
#       Port 587 uses STARTTLS (upgrades plain connection to TLS).
#
# ── Local dev with Mailpit ────────────────────────────────────────────────
# Mailpit runs in docker-compose at mailpit:1025, no auth.
# Web UI: http://localhost:8025
#
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#   SMTP_FROM=dev@localhost
#   SMTP_TLS=false
#
# ── Managed services (SendGrid, Mailgun, Amazon SES, Resend, etc.) ────────
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.your-sendgrid-api-key
#   SMTP_FROM=noreply@yourdomain.com

SMTP_HOST=localhost                 # [required]
SMTP_PORT=587                       # [optional] default: 587
SMTP_USERNAME=                      # [optional] empty = no auth (Mailpit)
SMTP_PASSWORD=                      # [optional] empty = no auth (Mailpit)
SMTP_FROM=univents@localhost        # [required]
SMTP_TLS=true                       # [optional] default: true

INFORMD_POSTGRES_HOST=informd-db
INFORMD_POSTGRES_PORT=5432
INFORMD_POSTGRES_DB=informd
INFORMD_POSTGRES_USER=informd
INFORMD_POSTGRES_PASSWORD=
INFORMD_POSTGRES_SSLMODE=disable
INFORMD_POSTGRES_CHANNEL_BINDING=prefer

# The Postgres image uses these to create this service's local database/role.
POSTGRES_DB=informd
POSTGRES_USER=informd
POSTGRES_PASSWORD=

APP_NAME=Informd
APP_URL=http://localhost:3004

CORS_ALLOWED_ORIGINS=http://localhost:3004

IDENTITY_X_PROJECT_ID=
IDENTITY_X_URL=
IDENTITY_X_API_KEY=

DEBUG_MODE=true
DISABLE_RATE_LIMIT=false
PROFILE_PORT=6062

CREDS_ENCRYPTION_PASSWORD=
CREDS_FILE_PATH=

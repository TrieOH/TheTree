{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "informd-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "api.informd.trieoh.com", "custom_domain": true }],

	"containers": [
		{
			"class_name": "InformdContainer",
			"image": "../Dockerfile",
			// The Dockerfile copies the Go workspace, so it builds from the repo root.
			"image_build_context": "../../..",
			"instance_type": "basic",
			"max_instances": 3,
			// Next to Neon (São Paulo).
			"constraints": { "regions": ["SAM"] }
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "INFORMD", "class_name": "InformdContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["InformdContainer"] }],

	// Every string binding, var or secret, reaches the container as an
	// environment variable (src/index.ts); the keys are those of
	// api/informd/.example.env. Public config lives here, reviewed with the
	// code.
	"vars": {
		"APP_NAME": "Informd",
		"APP_URL": "https://dev.informd.trieoh.com",
		"API_URL": "https://api.informd.trieoh.com",
		"CORS_ALLOWED_ORIGINS": "https://dev.informd.trieoh.com",
		"CORS_ALLOWED_HEADERS": "Content-Type,X-Request-ID,Authorization,X-API-KEY",
		"DEBUG_MODE": "true",
		"DISABLE_RATE_LIMIT": "false",
		"PROFILE_PORT": "6062",
		"IDENTITY_X_URL": "https://api.identityx.trieoh.com",
		"IDENTITY_X_PROJECT_ID": "01a01f27-2a79-7136-a7e8-22c8099baf71",
	},
	// Credentials are Worker secrets, set one at a time with
	// `wrangler secret put NAME` and kept across deploys. Listing them makes
	// `wrangler types` type them without reading a local .dev.vars/.env.
	"secrets": {
		"required": [
			"INFORMD_POSTGRES_HOST",
			"INFORMD_POSTGRES_PORT",
			"INFORMD_POSTGRES_DB",
			"INFORMD_POSTGRES_USER",
			"INFORMD_POSTGRES_PASSWORD",
			"IDENTITY_X_API_KEY",
		],
	},
}

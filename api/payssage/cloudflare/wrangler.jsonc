{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "payssage-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true,
		// exported to Grafana Cloud only (persist: false); destinations are account-level (Workers Observability)
		"traces": { "enabled": true, "destinations": ["grafana-traces"], "persist": false },
		"logs": { "enabled": true, "destinations": ["grafana-logs"], "persist": false }
	},
	"routes": [{ "pattern": "api.payssage.trieoh.com", "custom_domain": true }],

	"containers": [
		{
			"class_name": "PayssageContainer",
			"image": "../Dockerfile",
			// The Dockerfile copies the Go workspace, so it builds from the repo root.
			"image_build_context": "../../..",
			"instance_type": "lite",
			"max_instances": 1,
			// Next to Neon (São Paulo).
			"constraints": { "regions": ["SAM"] }
		}
	],
	// Shared awake-time pool that caps container spend (lib/ts/container-budget).
	"kv_namespaces": [{ "binding": "BUDGET", "id": "bc65d11390534722b1bfca37d503e99b" }],
	// One data point per request that had to start the container (@trieoh/container-budget).
	"analytics_engine_datasets": [{ "binding": "COLD_STARTS", "dataset": "container_cold_starts" }],
	"durable_objects": {
		"bindings": [{ "name": "PAYSSAGE", "class_name": "PayssageContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PayssageContainer"] }],

	// Background jobs: the container enqueues through the producer, the
	// consumer delivers each job back to the container's /events. Retries
	// back off per message (src/index.ts); a job out of retries lands on the
	// dead-letter queue, whose consumer runs the give-up job for it
	// (webhook.deliver → webhook.fail).
	"queues": {
		"producers": [{ "queue": "payssage-jobs", "binding": "JOBS" }],
		"consumers": [
			{
				"queue": "payssage-jobs",
				"max_batch_size": 10,
				"max_retries": 10,
				"dead_letter_queue": "payssage-jobs-dlq"
			},
			{
				"queue": "payssage-jobs-dlq",
				"max_batch_size": 10,
				"max_retries": 10
			}
		]
	},

	// Periodic jobs; must match PERIODIC in src/index.ts.
	"triggers": { "crons": ["0 */6 * * *"] },

	// Every string binding, var or secret, reaches the container as an
	// environment variable (src/index.ts); the keys are those of
	// api/payssage/.example.env, minus JOBS_URL. Public config lives here,
	// reviewed with the code.
	"vars": {
		// Keeps the Go heap under the lite instance's 256 MiB (Container only).
		"GOMEMLIMIT": "200MiB",
		"APP_NAME": "payssage",
		"APP_URL": "https://dev.payssage.trieoh.com",
		"API_URL": "https://api.payssage.trieoh.com",
		"CORS_ALLOWED_ORIGINS": "https://dev.payssage.trieoh.com,https://portal.trieoh.com",
		"CORS_ALLOWED_HEADERS": "Content-Type,X-Request-ID,Authorization,X-API-KEY,refresh_token",
		"PROFILE_PORT": "6062",
		"TEST_MODE": "true",
		"IDENTITY_X_URL": "https://api.identityx.trieoh.com",
		"IDENTITY_X_PROJECT_ID": "01a0026c-f093-7f7d-b751-a54a7d9b42d0",
		"MP_REDIRECT_URI": "https://dev.payssage.trieoh.com/callback/mercadopago",
		// Grafana Cloud OTLP gateway; the container appends /v1/<signal> (lib/go/telemetry).
		"OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp-gateway-prod-sa-east-1.grafana.net/otlp",
		// lowercase name in Grafana; APP_NAME stays the product name (emails, UI)
		"OTEL_SERVICE_NAME": "payssage",
	},
	// Credentials are Worker secrets, set one at a time with
	// `wrangler secret put NAME` and kept across deploys. Listing them makes
	// `wrangler types` type them without reading a local .dev.vars/.env.
	"secrets": {
		"required": [
			"PAYSSAGE_POSTGRES_HOST",
			"PAYSSAGE_POSTGRES_PORT",
			"PAYSSAGE_POSTGRES_DB",
			"PAYSSAGE_POSTGRES_USER",
			"PAYSSAGE_POSTGRES_PASSWORD",
			"IDENTITY_X_API_KEY",
			"MP_CLIENT_ID",
			"MP_CLIENT_SECRET",
			"MP_ACCESS_TOKEN",
			"MP_WEBHOOK_SECRET",
			"MP_TEST_ACCESS_TOKEN",
			"MP_TEST_PUBLIC_KEY",
			"SIMPLE_AUTH_USER",
			"SIMPLE_AUTH_PASS",
			// Authorization=Basic%20<base64(instanceID:token)>, from the stack's OpenTelemetry page.
			"OTEL_EXPORTER_OTLP_HEADERS",
		],
	},
}

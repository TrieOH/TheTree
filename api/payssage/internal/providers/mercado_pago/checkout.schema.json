{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trieoh.com/schemas/payssage/mercadopago-provider-data.json",
  "title": "MercadoPagoProviderData",
  "description": "Provider-specific data required to create a MercadoPago payment, embedded in CreateIntentRequest.provider_data",
  "type": "object",
  "properties": {
    "installments": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of installments for the payment. Required for card payments, unused for pix"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "MercadoPago card token (mp_card_token). Required for card payments, unused for pix"
    },
    "payment_method_id": {
      "type": "string",
      "minLength": 1,
      "description": "MercadoPago payment method identifier (e.g. visa, master, pix)"
    },
    "marketplace_fee_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Marketplace fee in basis points, used to calculate application_fee"
    },
    "statement_descriptor": {
      "type": "string",
      "maxLength": 22,
      "description": "Text shown on the payer's statement",
      "default": "payssage"
    },
    "payer": {
      "type": "object",
      "required": ["email", "identification_type", "identification_number"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "identification_type": {
          "type": "string",
          "description": "e.g. CPF, CNPJ",
          "minLength": 1
        },
        "identification_number": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "additional_info": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "quantity"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_cents": {
                "type": "integer",
                "minimum": 0,
                "description": "If omitted, defaults to intent's amount_cents"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "payment_method_id",
    "payer"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payment_method_id": { "const": "pix" }
        }
      },
      "then": {
        "properties": {
          "token": false,
          "installments": false
        }
      },
      "else": {
        "required": ["token", "installments"]
      }
    }
  ]
}
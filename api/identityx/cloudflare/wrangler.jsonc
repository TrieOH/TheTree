{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "identityx-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": { "enabled": true },

	"containers": [
		{
			"class_name": "IdentityXContainer",
			"image": "../Dockerfile",
			// The Dockerfile copies the Go workspace, so it builds from the repo root.
			"image_build_context": "../../..",
			"instance_type": "basic",
			"max_instances": 3
			// Pin placement near the Neon region once it is decided, e.g.
			// "constraints": { "regions": ["SAM"] }
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "IDENTITYX", "class_name": "IdentityXContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["IdentityXContainer"] }],

	// Background jobs: the container enqueues through the producer, the
	// consumer delivers each job back to the container's /events.
	"queues": {
		"producers": [{ "queue": "identityx-jobs", "binding": "JOBS" }],
		"consumers": [
			{
				"queue": "identityx-jobs",
				"max_batch_size": 10,
				"max_retries": 5,
				"dead_letter_queue": "identityx-jobs-dlq"
			}
		]
	},

	// Periodic jobs; must match PERIODIC in src/index.ts.
	"triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] },

	// Non-secret config. Every string binding, these and the secrets below,
	// is passed to the container as an environment variable.
	"vars": {
		// APP_URL and CORS_ALLOWED_ORIGINS: the IdentityX front's production URL.
		"APP_NAME": "IdentityX",
		"APP_URL": "https://identityx.com.br",
		"ISSUER": "https://identityx.com.br",

		"IDX_POSTGRES_PORT": "5432",
		"IDX_POSTGRES_DB": "identityx",
		"IDX_POSTGRES_SSLMODE": "require",
		"IDX_POSTGRES_CHANNEL_BINDING": "require",
		"IDX_POSTGRES_MAX_CONNS": "4",

		"IDENTITY_X_KEY_LIFETIME": "168h",
		"ROTATE_KEYS_JOB_DURATION": "24h",
		"ACCESS_TOKEN_LIFETIME": "15m",
		"REFRESH_TOKEN_LIFETIME": "168h",

		"CORS_ALLOWED_ORIGINS": "https://identityx.com.br",
		"CORS_ALLOWED_HEADERS": "Content-Type,X-Request-ID,Authorization,Refresh-Token,X-API-KEY",

		"DEBUG_MODE": "false",
		"DISABLE_RATE_LIMIT": "false",
		"RATE_LIMIT_RPS": "400",
		"RATE_LIMIT_BURST": "20",

		"EMAIL_FROM": "noreply@identityx.com.br",
		"SMTP_TLS": "true",
		"SMTP_STARTTLS": "false"
	}

	// Secrets (wrangler secret put <NAME>):
	//   IDX_POSTGRES_HOST (Neon pooled endpoint), IDX_POSTGRES_USER,
	//   IDX_POSTGRES_PASSWORD, ENCRYPTION_KEY, HMAC_SECRET,
	//   SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD,
	//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI,
	//   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_REDIRECT_URI,
	//   OTEL_EXPORTER_OTLP_ENDPOINT (and OTEL_EXPORTER_OTLP_HEADERS if needed)
}

# The API connects through a pooler: identityx-pooler (pgbouncer) locally,
# Neon's pooled (-pooler) endpoint when deployed.
IDX_POSTGRES_HOST=identityx-pooler
IDX_POSTGRES_PORT=5432
IDX_POSTGRES_DB=identityx
IDX_POSTGRES_USER=identityx
IDX_POSTGRES_PASSWORD=
IDX_POSTGRES_SSLMODE=disable
IDX_POSTGRES_CHANNEL_BINDING=prefer
# Pool size per process. Keep it small behind a pooler, and especially in
# managed mode where every function instance holds its own pool.
IDX_POSTGRES_MAX_CONNS=4
# Direct (unpooled) endpoint, reachable from where `just identityx-goose`
# runs: migrations take advisory locks, which need a session, not a pooler.
# Locally that is the published identityx-db port; on Neon it is the
# endpoint without -pooler.
IDX_POSTGRES_DIRECT_HOST=localhost
IDX_POSTGRES_DIRECT_PORT=5432

# The Postgres image uses these to create this service's local database/role.
POSTGRES_DB=identityx
POSTGRES_USER=identityx
POSTGRES_PASSWORD=

# hosted: long-lived server, jobs run in-process (compose).
# managed: request-scoped function (Lambda); jobs go to JOBS_QUEUE_URL and
# RUNTIME_ROLE=worker mounts /events. Set per function by the deploy.
RUNTIME_MODE=hosted
RUNTIME_ROLE=api
JOBS_QUEUE_URL=

# Where the rest of this config comes from besides the environment:
# env (default) or aws-secretsmanager (with SECRETS_ID). Explicit env wins.
SECRETS_PROVIDER=env
SECRETS_ID=

APP_NAME=IdentityX
APP_URL=http://localhost:3000

ISSUER='https://identityx.com.br'

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
HMAC_SECRET=
IDENTITY_X_KEY_LIFETIME=168h
ROTATE_KEYS_JOB_DURATION=24h

ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_LIFETIME=168h

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_HEADERS=Content-Type,X-Request-ID,Authorization,Refresh-Token,X-API-KEY

DEBUG_MODE=false
DISABLE_RATE_LIMIT=false
RATE_LIMIT_RPS=400
RATE_LIMIT_BURST=20
# pprof side port (hosted mode only)
PROFILE_PORT=6060

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Email: smtp (mailpit locally) or ses (AWS environment / Floci).
EMAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@identityx.dev

# SMTP (EMAIL_TRANSPORT=smtp)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_STARTTLS=false

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Telemetry is pushed over OTLP/HTTP (traces, metrics, logs). Each signal is
# exported only when its endpoint (or OTEL_EXPORTER_OTLP_ENDPOINT) is set.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://victoria-traces:10428/insert/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://victoria-metrics:8428/opentelemetry/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://victoria-logs:9428/insert/opentelemetry/v1/logs

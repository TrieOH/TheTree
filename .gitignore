# =============================================================
# 🔧 IDE & EDITORS
# =============================================================
.idea
.vscode/*

# =============================================================
# 📦 DEPENDENCIES
# =============================================================
node_modules

# =============================================================
# 🏗️ BUILD OUTPUT
# =============================================================
dist
.turbo
.wrangler

# =============================================================
# 🔐 ENVIRONMENT
# =============================================================
*.env
.env.local
!*.example.env
!.*.example.env

# =============================================================
# 🪵 LOGS
# =============================================================
.pnpm-debug.log

# =============================================================
# 📧 MOX
# =============================================================
/infra/mox/certs
/infra/mox/config/adminpasswd
/infra/mox/config/dkim
/infra/mox/config/domains.conf
/infra/mox/data

# =============================================================
# ⚙️ GENERATED
# =============================================================
**/generated/
**/coverage/
**/mocks/
api/**/docs/
!/docs/
**/sqlc/
# tools/problemgen output: the bundled spec and the problems package
# (regenerated by `just gen`; never committed)
api/*/api-spec.gen.yml
**/internal/problems/
# oapi-codegen output (regenerated by `just gen`; never committed)
**/internal/openapi/
# orval TS clients (regenerated by `just gen-ts`; never committed)
lib/ts/*/client/
# Workers types (regenerated by `just gen-cf` from wrangler.jsonc; never committed)
worker-configuration.d.ts
.sock

# =============================================================
# 🤖 AGENTS
# =============================================================
.pi-subagents
# transient planning docs (never committed)
docs/plans/

# husky internals (regenerated by the `prepare` script)
.husky/_/

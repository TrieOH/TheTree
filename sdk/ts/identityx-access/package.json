  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "dependencies": {
    "@trieoh/envoy-fetch-ts": "^0.1.5",
    "@trieoh/identityx-models": "workspace:*"
  }
}

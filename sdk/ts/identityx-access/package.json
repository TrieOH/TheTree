{
  "name": "@trieoh/identityx-access-sdk-ts",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK focused on IdentityX API keys and capabilities",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --minify",

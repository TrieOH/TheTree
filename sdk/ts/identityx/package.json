{
  "name": "@trieoh/identityx-sdk-ts",
  "version": "0.15.5",
  "type": "module",
  "description": "SDK to consume IdentityX",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm exec tsup && pnpm exec tsc -p tsconfig.types.json",
    "typecheck": "pnpm exec tsc -p . --noEmit",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "https://git.trieoh.com/TrieOH/TheTree"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@trieoh/envoy-fetch-ts": "catalog:",
    "ua-parser-js": "^2.0.10",
    "zod": "catalog:"
  }
}
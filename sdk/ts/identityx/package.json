{
  "name": "@trieoh/identityx-sdk-ts",
  "version": "0.12.15",
  "type": "module",
  "description": "SDK to consume IdentityX",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./react": {
      "types": "./dist/esm/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm exec tsup && pnpm exec tsc -p tsconfig.types.json",
    "typecheck": "pnpm exec tsc -p . --noEmit",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "https://git.trieoh.com/TrieOH/TheTree"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.4.4",
    "@storybook/react-vite": "10.4.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "baseline-browser-mapping": "^2.10.25",
    "postcss": "^8.5.14",
    "storybook": "10.4.4",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@trieoh/envoy-fetch-ts": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "ua-parser-js": "^2.0.10",
    "zod": "catalog:"
  }
}
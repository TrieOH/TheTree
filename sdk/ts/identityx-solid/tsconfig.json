{
  "compilerOptions": {
    "rootDir": "src",
    "target": "es2020",
    "module": "esnext",
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "env.d.ts"]
}

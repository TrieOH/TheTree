{
  "name": "@trieoh/payssage-sdk-ts",
  "version": "0.1.1",
  "type": "module",
  "description": "SDK to consume Payssage",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run clean && pnpm exec tsup && pnpm exec tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "typecheck": "pnpm exec tsc -p . --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@trieoh/envoy-fetch-ts": "catalog:"
  }
}

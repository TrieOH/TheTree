meta {
  name: Upsert Project Schema
  type: http
  seq: 4
}

put {
  url: {{identityx_url}}/projects/:project_id/profile-schema
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "schema": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "enum": ["Engineering", "Design", "Product", "Marketing"]
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": ["display_name", "department"]
    },
    "active": true
  }
}
